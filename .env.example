# Portable configuration contract for the auth service.
# Copy to .env for local development. Never commit real secrets.

# Any PostgreSQL provider (Neon, Supabase, RDS, local, ...).
DATABASE_URL=postgresql://predictmind:predictmind@localhost:5432/predictmind?schema=auth

# JWT signing secrets (use long random values in real environments).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d
RESET_TOKEN_TTL=1h

PORT=3002
